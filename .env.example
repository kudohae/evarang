# 사이트 접근 코드. 배포 환경에서는 반드시 설정하세요. 비워두면 누구나 API를 쓸 수 있습니다.
ACCESS_CODE=

# 음성인식. AssemblyAI가 기본이고, 실패하거나 크레딧이 떨어지면 GEMINI_API_KEY로 받아씁니다.
ASSEMBLYAI_API_KEY=

# 평가 모델 (무료 등급). Gemini Flash 모델들을 차례로 쓰고, 하루 한도를 다 쓰면 Groq로 넘어갑니다.
GEMINI_API_KEY=
GROQ_API_KEY=

# 선택: Groq 모델 ID. 비워두면 openai/gpt-oss-120b
GROQ_MODEL=

# 예측 개선용 저장. Vercel Storage에서 Neon과 Blob을 연결하면 자동으로 채워집니다.
DATABASE_URL=
# Vercel에서는 BLOB_STORE_ID(OIDC 인증)가 들어옵니다. 로컬에서는 스토어의 읽기·쓰기 토큰을 넣으세요.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# 사용량 확인에 쓰는 IP 해시의 비밀값. 아무 긴 임의 문자열. 비워두면 DATABASE_URL을 대신 씁니다.
USAGE_SALT=

# 하루 무료 횟수 제한을 받지 않는 회원의 이메일. 쉼표로 구분. 로그인한 상태여야 적용됩니다.
UNLIMITED_EMAILS=

# 관리자 화면(/admin) 코드. 비워두면 관리자 화면이 닫힙니다.
ADMIN_CODE=

# 만료 기록 삭제 작업(Vercel Cron)의 인증값
CRON_SECRET=

# 개인정보 처리방침에 표시할 운영자와 연락처
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
